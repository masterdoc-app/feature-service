# Copy to /etc/masterdoc-feature-service/.env on the VPS (CI materializes from secrets).
FEATURE_SERVICE_PORT=8082
ZITADEL_ISSUER=https://auth.example.com
ZITADEL_JWK_SET_URI=https://auth.example.com/oauth/v2/keys
# Optional — required for GET /users/{id}/features (WO assignee eligibility).
ZITADEL_MGMT_TOKEN=
ZITADEL_PROJECT_ID=
# Required for GET /users/{id}/features (fail-closed). Same value as dashboard INTERNAL_SERVICE_TOKEN.
# Clients must send header X-Internal-Token.
INTERNAL_SERVICE_TOKEN=
